{
  "$description": "Размеры текста на маленьком экране (до 844 px, телефон в альбомной 667 и портрет). Компонент пишет ds:text-title-lg — размер меняется сам. ВРЕМЕННЫЕ значения из InApp cars2/tm11.",
  "text": {
    "title-lg": {
      "size": { "$type": "dimension", "$value": 16 },
      "line-height": { "$type": "dimension", "$value": 20 },
      "weight": { "$type": "fontWeight", "$value": 800 }
    },
    "title-md": {
      "size": { "$type": "dimension", "$value": 16 },
      "line-height": { "$type": "dimension", "$value": 20 },
      "weight": { "$type": "fontWeight", "$value": 700 }
    },
    "button": {
      "size": { "$type": "dimension", "$value": 16 },
      "line-height": { "$type": "dimension", "$value": 20 },
      "weight": { "$type": "fontWeight", "$value": 700 }
    },
    "body": {
      "size": { "$type": "dimension", "$value": 14 },
      "line-height": { "$type": "dimension", "$value": 18 }
    },
    "caption": {
      "size": { "$type": "dimension", "$value": 12 },
      "line-height": { "$type": "dimension", "$value": 16 }
    },
    "badge": {
      "size": { "$type": "dimension", "$value": 10 },
      "line-height": { "$type": "dimension", "$value": 12 },
      "weight": { "$type": "fontWeight", "$value": 700 }
    }
  }
}
