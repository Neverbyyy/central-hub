{
  "$description": "Размеры текста на большом экране (от 1024 px, iPad и десктоп). Только то, что отличается от small. ВРЕМЕННЫЕ значения из InApp cars2/tm11.",
  "text": {
    "title-lg": {
      "size": { "$type": "dimension", "$value": 32 },
      "line-height": { "$type": "dimension", "$value": 40 }
    },
    "title-md": {
      "size": { "$type": "dimension", "$value": 24 },
      "line-height": { "$type": "dimension", "$value": 30 }
    },
    "button": {
      "size": { "$type": "dimension", "$value": 24 },
      "line-height": { "$type": "dimension", "$value": 32 }
    },
    "body": {
      "size": { "$type": "dimension", "$value": 20 },
      "line-height": { "$type": "dimension", "$value": 26 }
    },
    "caption": {
      "size": { "$type": "dimension", "$value": 16 },
      "line-height": { "$type": "dimension", "$value": 20 }
    },
    "badge": {
      "size": { "$type": "dimension", "$value": 12 },
      "line-height": { "$type": "dimension", "$value": 16 }
    }
  }
}
