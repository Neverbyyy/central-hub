{
  "name": "amaya-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter central-hub dev",
    "build": "pnpm --filter central-hub build",
    "lint": "pnpm --filter central-hub lint",
    "typecheck": "pnpm --filter central-hub typecheck",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "db:push": "supabase db push",
    "db:new": "supabase migration new"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.104.1",
    "supabase": "2.122.0",
    "vitest": "5.0.5"
  }
}
