{
  "name": "amaya-hub",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter central-hub dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "storybook": "turbo run dev --filter=@amaya/storybook...",
    "l10n": "node scripts/l10n.mjs",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:stand": "vitest run --project stand",
    "db:start": "supabase start -x studio,imgproxy,mailpit,edge-runtime,logflare,vector,supavisor,storage-api,postgres-meta",
    "db:stop": "supabase stop --no-backup",
    "db:push": "supabase db push --linked",
    "db:new": "supabase migration new"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@nuxt/eslint-config": "^1.15.2",
    "@supabase/supabase-js": "^2.104.1",
    "eslint": "^10.2.1",
    "puppeteer-core": "^24.43.1",
    "supabase": "2.122.0",
    "turbo": "^2.11.10",
    "vitest": "5.0.5",
    "vue-eslint-parser": "^10.4.0"
  }
}
