# Supabase: Project Settings → API Keys
NUXT_PUBLIC_SUPABASE_URL=
# Публичный ключ: браузер только читает (права закрыты миграцией lockdown)
NUXT_PUBLIC_SUPABASE_KEY=
# Секретный ключ: только на сервере, через него идут все записи
NUXT_SUPABASE_SECRET_KEY=

# Вход в сервис (README, «Вход») — через Google и по общему паролю; не задан один — на странице входа только другой.
# Google: OAuth-клиент Google Cloud, тип Web application. Пускает любой рабочий аккаунт Google Workspace компании
# (домен — authDomain в nuxt.config, сейчас amayasoft.uz)
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
# Общий пароль сервиса: имя для подписи правок человек вводит сам при входе
NUXT_HUB_PASSWORD=
# Ключ шифрования cookie сессии, не короче 32 символов
NUXT_SESSION_PASSWORD=
# Токен для CLI amaya-l10n (в проектах он передаётся как AMAYA_L10N_TOKEN)
NUXT_CLI_TOKEN=
# Токен MCP для нейросетей (в .mcp.json — переменная AMAYA_HUB_TOKEN). Один на всех — его показывает и копирует
# раздел «MCP» (/ai) тем, кто вошёл в сервис
NUXT_MCP_TOKEN=
# Токен плагина Figma «Amaya Hub — локализация», только чтение: дизайнер вставляет его в плагин. Один на всех —
# его показывает и копирует окно «Тексты в Figma» тем, кто вошёл в сервис
NUXT_FIGMA_TOKEN=
# Только для разработки, сервису не нужен: личный токен Figma (File content — read-only), чтобы читать макеты
# Антона через REST API — у Figma MCP на тарифе Starter 6 вызовов в месяц
FIGMA_ACCESS_TOKEN=
# Кнопка «Выгрузить в код»: fine-grained токен GitHub только на репозитории из NUXT_EXPORT_REPOS
# (Contents и Pull requests — на запись). Сервис пишет только в ветку amaya-hub/<набор> и PR
NUXT_GITHUB_TOKEN=
# Набор выгрузки=owner/repo[@ветка], через запятую. Без ветки — основная ветка репозитория
NUXT_EXPORT_REPOS=inapp=Neverbyyy/amaya-demo-inapp,pages_hub=Neverbyyy/amaya-demo-pages-hub
# Секрет вебхука GitHub (Settings → Webhooks, событие Pull requests): окно «Выгрузка в код» узнаёт о мерже сразу.
# Тот же секрет — в настройках вебхука каждого репозитория из NUXT_EXPORT_REPOS
NUXT_GITHUB_WEBHOOK_SECRET=

# Только для Supabase CLI (db push / link) и тестов базы
SUPABASE_DB_PASSWORD=

# `pnpm l10n pull` — тексты набора ds со стенда в packages/locales: токен CLI стенда (NUXT_CLI_TOKEN в Vercel),
# не локальный NUXT_CLI_TOKEN выше
AMAYA_L10N_TOKEN=
