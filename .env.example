# Supabase: Project Settings → API Keys
NUXT_PUBLIC_SUPABASE_URL=
# Публичный ключ: браузер только читает (права закрыты миграцией lockdown)
NUXT_PUBLIC_SUPABASE_KEY=
# Секретный ключ: только на сервере, через него идут все записи
NUXT_SUPABASE_SECRET_KEY=

# Общий пароль сервиса
NUXT_HUB_PASSWORD=
# Ключ шифрования cookie сессии, не короче 32 символов
NUXT_SESSION_PASSWORD=

# Только для Supabase CLI (db push / link) и тестов базы
SUPABASE_DB_PASSWORD=
