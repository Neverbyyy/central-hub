# Supabase: Project Settings → API Keys
NUXT_PUBLIC_SUPABASE_URL=
# Публичный ключ: браузер только читает (права закрыты миграцией lockdown)
NUXT_PUBLIC_SUPABASE_KEY=
# Секретный ключ: только на сервере, через него идут все записи
NUXT_SUPABASE_SECRET_KEY=

# Общий пароль сервиса
NUXT_HUB_PASSWORD=
# Ключ шифрования cookie сессии, не короче 32 символов
NUXT_SESSION_PASSWORD=
# Токен для CLI amaya-l10n (в проектах он передаётся как AMAYA_L10N_TOKEN)
NUXT_CLI_TOKEN=
# Токен MCP для нейросетей (в .mcp.json — переменная AMAYA_HUB_TOKEN)
NUXT_MCP_TOKEN=
# Токен плагина Figma «Amaya Hub — локализация», только чтение: дизайнер вставляет его в плагин
NUXT_FIGMA_TOKEN=
# Кнопка «Выгрузить в код»: fine-grained токен GitHub только на репозитории из NUXT_EXPORT_REPOS
# (Contents и Pull requests — на запись). Сервис пишет только в ветку amaya-hub/<набор> и PR
NUXT_GITHUB_TOKEN=
# Набор выгрузки=owner/repo[@ветка], через запятую. Без ветки — основная ветка репозитория
NUXT_EXPORT_REPOS=inapp=Neverbyyy/amaya-demo-inapp,pages_hub=Neverbyyy/amaya-demo-pages-hub

# Только для Supabase CLI (db push / link) и тестов базы
SUPABASE_DB_PASSWORD=
