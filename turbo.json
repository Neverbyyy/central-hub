{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "storybook-static/**", ".output/**", ".vercel/output/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "@amaya/ui#lint": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/paywall-kit/src/**", "$TURBO_ROOT$/packages/landing-kit/src/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    }
  }
}
